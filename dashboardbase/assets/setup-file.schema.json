{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.dashboardbase.com/setup-file/schema/v1.json",
  "title": "Dashboardbase Setup File v1",
  "description": "Setup file format for wiring, importing, exporting, and planning Dashboardbase dashboards.",
  "type": "object",
  "required": [
    "mappings"
  ],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference. Should be \u0027https://api.dashboardbase.com/setup-file/schema/v1.json\u0027."
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Schema version. Currently only 1 is supported. Omit to default to 1."
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Dashboard UUID. If present, operations target this dashboard. If absent, a new dashboard is created on import."
    },
    "name": {
      "type": "string",
      "description": "Human-readable dashboard name. Saved alongside the config so each file on disk carries the dashboard it configures.",
      "examples": [
        "MRR Overview"
      ]
    },
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "description": "Default base URL for mappings without a datasourceId and without an absolute path.",
      "examples": [
        "https://api.example.com"
      ]
    },
    "datasources": {
      "type": "array",
      "description": "Named datasources with their own baseUrl. Credentials are never included here.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "baseUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this datasource within the file.",
            "examples": [
              "stripe",
              "posthog",
              "internal-api"
            ]
          },
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "description": "Base URL for this datasource.",
            "examples": [
              "https://api.stripe.com"
            ]
          }
        }
      }
    },
    "refreshInterval": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "10m",
        "30m"
      ],
      "description": "Default refresh interval for all widgets in the dashboard."
    },
    "mappings": {
      "type": "array",
      "description": "Widget mappings. Each entry is in one of four states: A (wire existing), B (create wired), C (create plan), or D (recreate existing widget with its full spec, as produced by export).",
      "items": {
        "oneOf": [
          {
            "title": "State A \u2014 Wire existing widget",
            "description": "Connect an existing widget in the dashboard to an endpoint. Requires widgetId and path.",
            "type": "object",
            "required": [
              "widgetId",
              "path"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "type"
                  ]
                },
                {
                  "required": [
                    "plan"
                  ]
                }
              ]
            },
            "properties": {
              "widgetId": {
                "type": "string",
                "format": "uuid",
                "description": "UUID of an existing widget in the dashboard."
              },
              "path": {
                "type": "string",
                "description": "Endpoint path (relative to baseUrl or datasource) or absolute URL.",
                "examples": [
                  "/metrics/mrr",
                  "https://api.example.com/metrics/mrr"
                ]
              },
              "datasourceId": {
                "type": "string",
                "description": "References a datasource declared in the top-level \u0027datasources\u0027 array."
              }
            }
          },
          {
            "title": "State B \u2014 Create new wired widget",
            "description": "Create a new widget connected to a real endpoint. Requires type and path.",
            "type": "object",
            "required": [
              "type",
              "path"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "widgetId"
                  ]
                },
                {
                  "required": [
                    "plan"
                  ]
                }
              ]
            },
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "kpi",
                  "status",
                  "table",
                  "line",
                  "bar",
                  "pie",
                  "donut",
                  "gauge"
                ],
                "description": "Widget type."
              },
              "path": {
                "type": "string",
                "description": "Endpoint path (relative to baseUrl or datasource) or absolute URL.",
                "examples": [
                  "/metrics/mrr",
                  "https://api.stripe.com/v1/metrics/mrr"
                ]
              },
              "datasourceId": {
                "type": "string",
                "description": "References a datasource declared in the top-level \u0027datasources\u0027 array."
              },
              "size": {
                "type": "object",
                "description": "Widget size on the 12-column grid. Omit to use the widget type\u0027s default (3\u00D71 for compact single-value widgets like KPI, 6\u00D74 otherwise). Out-of-range values are clamped when the widget is added.",
                "properties": {
                  "w": {
                    "type": "integer",
                    "minimum": 3,
                    "maximum": 12,
                    "description": "Width in grid columns (3-12)."
                  },
                  "h": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8,
                    "description": "Height in grid rows (1-8)."
                  }
                }
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "title": "State C \u2014 Plan widget",
            "description": "A conceptual widget with a goal but no endpoint yet. Used for sharing a dashboard spec.",
            "type": "object",
            "required": [
              "type",
              "plan"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "widgetId"
                  ]
                },
                {
                  "required": [
                    "path"
                  ]
                }
              ]
            },
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "kpi",
                  "status",
                  "table",
                  "line",
                  "bar",
                  "pie",
                  "donut",
                  "gauge"
                ],
                "description": "Widget type."
              },
              "plan": {
                "type": "object",
                "required": [
                  "goal"
                ],
                "description": "Plan metadata describing what this widget should show.",
                "properties": {
                  "goal": {
                    "type": "string",
                    "description": "What this widget should display. Required.",
                    "examples": [
                      "Monthly recurring revenue",
                      "Active users today"
                    ]
                  },
                  "dateRange": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Date range for the data, e.g. \u0027current month\u0027, \u0027last 30 days\u0027."
                  },
                  "groupBy": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Dimension to group by, e.g. \u0027country\u0027, \u0027plan\u0027."
                  },
                  "dataSource": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Conceptual data source (e.g. \u0027stripe\u0027, \u0027database\u0027). Not a configured datasource reference.",
                    "examples": [
                      "stripe",
                      "auth0",
                      "database",
                      "posthog"
                    ]
                  }
                }
              },
              "size": {
                "type": "object",
                "description": "Widget size on the 12-column grid. Omit to use the widget type\u0027s default (3\u00D71 for compact single-value widgets like KPI, 6\u00D74 otherwise). Out-of-range values are clamped when the widget is added.",
                "properties": {
                  "w": {
                    "type": "integer",
                    "minimum": 3,
                    "maximum": 12,
                    "description": "Width in grid columns (3-12)."
                  },
                  "h": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8,
                    "description": "Height in grid rows (1-8)."
                  }
                }
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "title": "State D \u2014 Recreate existing widget",
            "description": "An existing widget exported with its full spec so the dashboard can be recreated: widgetId plus type/size/position, and either a path (wired) or a plan. This is the shape produced by export-setup-file.",
            "type": "object",
            "required": [
              "widgetId",
              "type"
            ],
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "plan"
                ]
              }
            ],
            "not": {
              "required": [
                "path",
                "plan"
              ]
            },
            "properties": {
              "widgetId": {
                "type": "string",
                "format": "uuid",
                "description": "UUID of an existing widget in the dashboard."
              },
              "type": {
                "type": "string",
                "enum": [
                  "kpi",
                  "status",
                  "table",
                  "line",
                  "bar",
                  "pie",
                  "donut",
                  "gauge"
                ],
                "description": "Widget type."
              },
              "path": {
                "type": "string",
                "description": "Endpoint path (relative to baseUrl or datasource) or absolute URL. Present for wired widgets.",
                "examples": [
                  "/metrics/mrr",
                  "https://api.example.com/metrics/mrr"
                ]
              },
              "plan": {
                "type": "object",
                "required": [
                  "goal"
                ],
                "description": "Plan metadata describing what this widget should show. Present for plan widgets.",
                "properties": {
                  "goal": {
                    "type": "string",
                    "description": "What this widget should display. Required.",
                    "examples": [
                      "Monthly recurring revenue",
                      "Active users today"
                    ]
                  },
                  "dateRange": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Date range for the data, e.g. \u0027current month\u0027, \u0027last 30 days\u0027."
                  },
                  "groupBy": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Dimension to group by, e.g. \u0027country\u0027, \u0027plan\u0027."
                  },
                  "dataSource": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Conceptual data source (e.g. \u0027stripe\u0027, \u0027database\u0027). Not a configured datasource reference.",
                    "examples": [
                      "stripe",
                      "auth0",
                      "database",
                      "posthog"
                    ]
                  }
                }
              },
              "datasourceId": {
                "type": "string",
                "description": "References a datasource declared in the top-level \u0027datasources\u0027 array."
              },
              "size": {
                "type": "object",
                "description": "Widget size on the 12-column grid. Omit to use the widget type\u0027s default (3\u00D71 for compact single-value widgets like KPI, 6\u00D74 otherwise). Out-of-range values are clamped when the widget is added.",
                "properties": {
                  "w": {
                    "type": "integer",
                    "minimum": 3,
                    "maximum": 12,
                    "description": "Width in grid columns (3-12)."
                  },
                  "h": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8,
                    "description": "Height in grid rows (1-8)."
                  }
                }
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
